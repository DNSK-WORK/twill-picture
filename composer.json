{
    "name": "dnsk-work/twill-picture",
    "description": "Progressive blur-up <x-twill-picture::picture> Blade component for Twill + Glide (or any query-param image transform service)",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/DNSK-WORK/twill-picture",
    "keywords": ["laravel", "twill", "glide", "image", "blade", "lqip", "progressive-image", "webp", "srcset", "responsive-images", "blur-up"],
    "support": {
        "issues": "https://github.com/DNSK-WORK/twill-picture/issues",
        "source": "https://github.com/DNSK-WORK/twill-picture"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "DnskWork\\TwillPicture\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DnskWork\\TwillPicture\\TwillPictureServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
