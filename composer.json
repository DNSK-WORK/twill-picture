{
    "name": "dnsk-work/twill-picture",
    "description": "Progressive blur-up <x-twill-picture::picture> Blade component for Twill + Glide (or any query-param image transform service)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "DnskWork\\TwillPicture\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DnskWork\\TwillPicture\\TwillPictureServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
